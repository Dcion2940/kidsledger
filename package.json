{
  "name": "kidsledger-pro---小朋友智慧記帳王",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check": "npm run typecheck && npm run build",
    "build": "vite build",
    "build:pages": "npm run build",
    "build:gh": "VITE_BASE_PATH=/kidsledger/ vite build",
    "build:cf": "VITE_BASE_PATH=/ vite build",
    "preview": "vite preview",
    "predeploy": "npm run build:gh",
    "deploy": "gh-pages -d dist",
    "deploy:pages": "wrangler pages deploy dist --project-name kidsledger --branch main"
  },
  "dependencies": {
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "@google/genai": "^1.40.0",
    "lucide-react": "^0.563.0",
    "recharts": "^3.7.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
    "gh-pages": "^6.3.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
